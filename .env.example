# ZentroMart VoiceOps Configuration

# LLM API Keys (choose your provider)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gnani.ai Voice APIs (Speech-To-Text & Text-To-Speech)
# Get your key at: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# Dataset Directory (defaults to local directory)
DATASET_DIR=.
